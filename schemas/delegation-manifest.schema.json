{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "runtime_id": {
      "type": "string"
    },
    "base_head": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sha256",
          "kind",
          "recorded_at"
        ],
        "additionalProperties": false
      }
    },
    "harness_version": {
      "const": "0.9.1"
    },
    "harness_release_sha256": {
      "type": "string"
    },
    "chelm_version": {
      "const": "0.2.0"
    },
    "offered_by": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "runtime_id",
    "base_head",
    "observations",
    "harness_version",
    "harness_release_sha256",
    "chelm_version",
    "offered_by",
    "participants",
    "created_at",
    "expires_at",
    "note",
    "files"
  ],
  "additionalProperties": false
}
