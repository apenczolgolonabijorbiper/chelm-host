{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chelm cognitive task create v1",
  "description": "Supply exactly one of text/messages. Portable message/scope/limit validation is delegated to the negotiated Harness cognitive-task schema.",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "mode": {
      "enum": [
        "read_only",
        "propose_learning"
      ]
    },
    "scope": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "freshness": {
      "enum": [
        "allow_stale",
        "require_current"
      ]
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_continuations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 86400000
    },
    "output_max_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    }
  },
  "required": [
    "idempotency_key"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "text"
      ],
      "not": {
        "required": [
          "messages"
        ]
      }
    },
    {
      "required": [
        "messages"
      ],
      "not": {
        "required": [
          "text"
        ]
      }
    }
  ]
}
