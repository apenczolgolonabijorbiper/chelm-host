{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "runtime_id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "resettable": {
          "type": "boolean"
        }
      },
      "required": [
        "resettable"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "git": {
          "type": "string"
        }
      },
      "required": [
        "root",
        "node",
        "python",
        "git"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "git_identity": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "git_identity"
      ],
      "additionalProperties": false
    },
    "intake": {
      "type": "object",
      "properties": {
        "subject_header": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "max_observation_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_message_chars": {
          "type": "integer",
          "minimum": 1
        },
        "question_source": {
          "type": "string"
        },
        "oversize": {
          "enum": [
            "truncate",
            "refuse"
          ]
        },
        "kind_sets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "subject_header",
        "max_observation_chars",
        "max_message_chars",
        "question_source",
        "oversize",
        "kind_sets"
      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "tail": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "tail"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_open_proposed_per_subject": {
          "type": "integer",
          "minimum": 1
        },
        "reason_max_chars": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kinds",
        "max_open_proposed_per_subject",
        "reason_max_chars"
      ],
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "profile_expectation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "enforce": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "enforce"
      ],
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "properties": {
        "max_active_work": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "assignment_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "max_lifetime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "max_active_work",
        "assignment_minutes",
        "max_lifetime_minutes"
      ],
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "operation_phases": {
          "type": "boolean"
        },
        "read_metrics": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "json-git"
        },
        "provider_version": {
          "const": 1
        },
        "host_api_version": {
          "const": 2
        },
        "storage_version": {
          "const": 2
        }
      },
      "required": [
        "kind",
        "provider_version",
        "host_api_version",
        "storage_version"
      ],
      "additionalProperties": false
    },
    "preferred_cognizer": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "disabled",
            "prefer",
            "require"
          ]
        },
        "cognizer_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "work_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "observation",
              "cognitive"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "fallback": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "readiness_ttl_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "binding_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "transport": {
                "enum": [
                  "local",
                  "remote"
                ]
              },
              "principal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\x00-\\x1f]+$"
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\x00-\\x1f]+$"
              },
              "cognizer_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "binding_id",
              "transport",
              "principal",
              "cognizer_id"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "transport": {
                      "const": "local"
                    }
                  },
                  "required": [
                    "transport"
                  ]
                },
                "then": {
                  "required": [
                    "host"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "transport": {
                      "const": "remote"
                    }
                  },
                  "required": [
                    "transport"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "host"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "schema_version",
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "prefer",
                  "require"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "cognizer_id",
              "work_kinds",
              "grace_seconds",
              "fallback",
              "readiness_ttl_seconds",
              "workers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "require"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "fallback": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "disabled"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "schema_version": {},
              "mode": {}
            },
            "additionalProperties": false
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "runtime_id",
    "label",
    "sandbox",
    "harness",
    "instance",
    "intake",
    "conversation",
    "requests",
    "archive",
    "remote"
  ],
  "additionalProperties": false
}
