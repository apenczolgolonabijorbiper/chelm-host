{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "fulfilled",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "subject_id",
    "reason",
    "status",
    "created_at",
    "created_by",
    "updated_at",
    "note"
  ],
  "additionalProperties": false
}
